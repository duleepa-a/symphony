# Copy this file to .env and replace the dummy value with a real provider key.
GOOGLE_API_KEY=dummy-symphony-replace-with-real-gemini-key
LLM_MODEL=gemini/gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini/gemini-3.1-flash-lite

# Service Provider Mode: mock (default in-memory simulation) or real (local Docker microservices)
SYMPHONY_SERVICE_MODE=mock

# Optional custom URLs for local microservices (defaults to http://localhost:810X)
# SERVICE_FRONTEND_URL=http://localhost:8100
# SERVICE_AUTH_URL=http://localhost:8101
# SERVICE_PAYMENT_URL=http://localhost:8102
# SERVICE_CATALOG_URL=http://localhost:8103
# SERVICE_API_GATEWAY_URL=http://localhost:8104
# SERVICE_DATABASE_URL=http://localhost:8105
